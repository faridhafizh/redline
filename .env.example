# DeepSeek (wajib untuk fitur analisis AI)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro

# Label model yang ditampilkan di klien (harus sama dengan di atas)
NEXT_PUBLIC_DEEPSEEK_MODEL=deepseek-flash
NEXT_PUBLIC_DEEPSEEK_MODEL_PRO=deepseek-v4-pro

# Numverify (opsional; sumber operator/jenis nomor telepon)
# Tanpa key ini, sumber Numverify otomatis tidak disummon saat pencarian nomor.
NUMVERIFY_API_KEY=

# Upstash Redis (opsional; tanpa ini rate limit & cache memakai in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
